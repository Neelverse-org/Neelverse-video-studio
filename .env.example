# Required security settings. Generate the secret with: openssl rand -hex 32
NEELVERSE_SECRET_KEY=replace-with-at-least-32-random-characters
NEELVERSE_ADMIN_USERNAME=admin
NEELVERSE_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Public web address and cookie policy
NEELVERSE_PUBLIC_ORIGIN=http://YOUR_SERVER_IP:8080
NEELVERSE_WEB_PORT=8080
NEELVERSE_COOKIE_SECURE=false

# Hugging Face model access. Keep this file private.
HF_TOKEN=
NEELVERSE_KREA_MODEL_ID=krea/krea-realtime-video
NEELVERSE_KREA_MODEL_REVISION=
NEELVERSE_KREA_ENABLE_FP8=true
NEELVERSE_KREA_ENABLE_COMPILE=true

# L40S generation defaults
NEELVERSE_NATIVE_FPS=8
NEELVERSE_DISPLAY_FPS=24

# Optional TURN relay for users outside the server LAN.
# Start it with: docker compose --profile turn -f docker-compose.yml -f docker-compose.gpu.yml up -d
TURN_EXTERNAL_IP=YOUR_PUBLIC_SERVER_IP
TURN_REALM=neelverse.example.com
TURN_USERNAME=neelverse
TURN_PASSWORD=replace-with-a-long-turn-password
VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_PUBLIC_SERVER_IP:3478","username":"neelverse","credential":"replace-with-a-long-turn-password"}]
